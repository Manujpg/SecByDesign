# Vorlage für die lokale Entwicklung. Kopieren nach backend/.env und eigene Werte setzen.
# backend/.env ist per .gitignore ausgeschlossen und darf nie committet werden.
#
# Zufällige Passwörter erzeugen (Git Bash):
#   openssl rand -base64 24

APP_ENV=dev
LOG_LEVEL=DEBUG

DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=praxistermin
DB_SSLMODE=disable

# Laufzeitkonto der API (nur DML)
DB_USER=praxis_app
DB_PASSWORD=

# Nur für dev/compose.yaml und für "alembic upgrade" lokal
DB_MIGRATE_PASSWORD=
POSTGRES_SUPERUSER_PASSWORD=

# Server-Schlüssel (mind. 32 Zeichen), z. B. openssl rand -hex 32
APP_SECRET_KEY=

# Erlaubte Origins für POST/PUT/PATCH/DELETE (CSRF-Schutz), kommagetrennt.
# Vite-Dev-Server des Frontends + lokaler Ingress.
ALLOWED_ORIGINS=http://localhost:5173,https://localhost

# Erstes Admin-Konto, wird nur angelegt, solange es noch keine Nutzer:innen gibt.
# Passwort mind. 16 Zeichen; muss beim ersten Login geändert werden.
ADMIN_BOOTSTRAP_EMAIL=admin@aerztehaus-lindle.de
ADMIN_BOOTSTRAP_PASSWORD=
