# Vorlage für die lokale Entwicklung. Kopieren nach backend/.env und eigene Werte setzen.
# backend/.env ist per .gitignore ausgeschlossen und darf nie committet werden.
#
# Zufällige Passwörter erzeugen (Git Bash):
#   openssl rand -base64 24

APP_ENV=dev
LOG_LEVEL=DEBUG

DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=praxistermin
DB_SSLMODE=disable

# Laufzeitkonto der API (nur DML)
DB_USER=praxis_app
DB_PASSWORD=

# Nur für dev/compose.yaml und für "alembic upgrade" lokal
DB_MIGRATE_PASSWORD=
POSTGRES_SUPERUSER_PASSWORD=
